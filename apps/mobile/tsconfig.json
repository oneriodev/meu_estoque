{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // As mesmas regras rígidas do resto do monorepo (tsconfig.base.json da raiz)
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Atalho de importação: "@/components/..." em vez de "../../components/..."
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}