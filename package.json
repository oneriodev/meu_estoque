{
  "name": "meu-estoque",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @meu-estoque/shared",
    "dev:shared": "npm run dev -w @meu-estoque/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "npm run start:dev -w @meu-estoque/api",
    "db:migrate": "npm run db:migrate -w @meu-estoque/api --",
    "db:studio": "npm run db:studio -w @meu-estoque/api",
    "db:seed": "npm run db:seed -w @meu-estoque/api",
    "db:generate": "npm run prisma:generate -w @meu-estoque/api"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "~6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
