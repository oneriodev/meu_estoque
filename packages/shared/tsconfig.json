{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true, // gera os .d.ts (os tipos) para quem importar
    "declarationMap": true, // "ir para definição" no VS Code abre o .ts original
    "sourceMap": true
  },
  "include": ["src"]
}
