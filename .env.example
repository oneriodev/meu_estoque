# Copie para .env e preencha. O .env NUNCA vai para o Git.
NODE_ENV=development

# PostgreSQL (Docker)
POSTGRES_USER=meu_estoque
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=meu_estoque
POSTGRES_PORT=5433

# Redis (Docker)
REDIS_PASSWORD=troque_esta_senha
REDIS_PORT=6379

# API
API_PORT=3000

# Origens do navegador liberadas no CORS, separadas por vírgula (vazio = nenhuma)
CORS_ORIGINS=

# Conexão do Prisma com o PostgreSQL (mesmo usuário, senha e porta do Docker)
DATABASE_URL=postgresql://meu_estoque:troque_esta_senha@localhost:5433/meu_estoque?schema=public

# Autenticação
# Gere com: openssl rand -hex 32  (NUNCA reaproveite entre ambientes)
JWT_ACCESS_SECRET=troque_por_uma_chave_aleatoria_de_64_caracteres
JWT_ACCESS_TTL_SEGUNDOS=900

# Seed (somente desenvolvimento): administrador inicial
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_SENHA=troque_esta_senha_com_12_ou_mais_caracteres